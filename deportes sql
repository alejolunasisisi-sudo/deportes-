CREATE   PROCEDURE [dbo].[sp_CalcularRecaudo]
    @id_cancha INT,
    @total_recaudo DECIMAL(10,2) OUTPUT
AS
BEGIN
    SET NOCOUNT ON;
    
    SELECT @total_recaudo = ISNULL(SUM(valor), 0.00)
    FROM Reservas
    WHERE id_cancha = @id_cancha;
END;
