/* =========================================================
   PROCEDIMIENTO 1
   PARÁMETRO DE ENTRADA
   ========================================================= */

CREATE PROCEDURE [dbo].[sp_BuscarEvento]
    @id_evento INT
AS
BEGIN
    SELECT
        e.id_evento,
        e.nombre,
        e.fecha,
        e.lugar,
        e.precio,
        c.nombre AS categoria
    FROM Eventos e
    INNER JOIN Categoria c
        ON e.id_categoria = c.id_categoria
    WHERE e.id_evento = @id_evento;
END;

