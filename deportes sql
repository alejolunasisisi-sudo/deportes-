/* =========================================================
   PROCEDIMIENTO 3
   PARÁMETRO DE ENTRADA Y SALIDA
   ========================================================= */

CREATE PROCEDURE [dbo].[sp_AumentarPrecio]
    @id_evento INT,
    @precio DECIMAL(10,2) OUTPUT
AS
BEGIN

    SELECT @precio = precio
    FROM Eventos
    WHERE id_evento = @id_evento;

    SET @precio = @precio + 10000;

    UPDATE Eventos
    SET precio = @precio
    WHERE id_evento = @id_evento;

END;

